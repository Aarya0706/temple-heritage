+.festival-days-badge-passed {
+  background: rgba(90, 80, 74, 0.75);
+  color: #e7ded6;
+}
+
+.festival-card-link-passed .festival-card {
+  opacity: 0.55;
+  filter: grayscale(35%);
+}
+
+.festival-card-link-passed .festival-card:hover {
+  opacity: 0.85;
+}
+
+.festival-temples-grid {
+  max-width: 1250px;
+  margin: 30px auto 0;
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
+  gap: 20px;
+}
+
+.festival-temple-card {
+  display: block;
+  overflow: hidden;
+  border-radius: 18px;
+  background: #fffdf9;
+  border: 1px solid var(--border);
+  box-shadow: 0 10px 24px rgba(88, 32, 15, 0.10);
+  transition: transform 0.25s ease, box-shadow 0.25s ease;
+  color: inherit;
+  text-decoration: none;
+}
+
+.festival-temple-card:hover {
+  transform: translateY(-5px);
+  box-shadow: 0 16px 32px rgba(88, 32, 15, 0.16);
+}
+
+.festival-temple-image {
+  height: 140px;
+  overflow: hidden;
+}
+
+.festival-temple-image img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  display: block;
+}
+
+.festival-temple-info {
+  padding: 14px 16px;
+}
+
+.festival-temple-info h4 {
+  margin: 0 0 6px;
+  font: 700 17px "Playfair Display", serif;
+  color: #542019;
+}
+
+.festival-temple-info p {
+  margin: 0;
+  font-size: 13px;
+  color: #80665d;
+  display: flex;
+  align-items: center;
+  gap: 5px;
+}
+
 .festival-countdown {
