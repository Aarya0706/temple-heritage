+"use client";
+
+import { useState } from "react";
+import {
+  X,
+  Maximize2,
+  PanelRightOpen,
+  PictureInPicture2,
+} from "lucide-react";
+import AssistantChatUI from "./AssistantChatUI";
+
+type Mode = "popup" | "side" | "fullscreen";
+
+const MODE_OPTIONS: { mode: Mode; label: string; icon: typeof Maximize2 }[] = [
+  { mode: "popup", label: "Popup", icon: PictureInPicture2 },
+  { mode: "side", label: "Side by side", icon: PanelRightOpen },
+  { mode: "fullscreen", label: "Fullscreen", icon: Maximize2 },
+];
+
+export function AssistantWidget() {
+  const [open, setOpen] = useState(false);
+  // Kept even while closed so re-opening the widget lands back on
+  // whichever layout the person had last, instead of always resetting
+  // to popup.
+  const [mode, setMode] = useState<Mode>("popup");
+
+  if (!open) {
+    return (
+      <button
+        type="button"
+        onClick={() => setOpen(true)}
+        className="floating-chat"
+        aria-label="Open Temple AI Assistant"
+      >
+        🤖
+      </button>
+    );
+  }
+
+  return (
+    <div className={`assistant-widget assistant-widget-${mode}`}>
+      <div className="assistant-widget-header">
+        <span className="assistant-widget-title">🪷 TempleGuide</span>
+
+        <div className="assistant-widget-controls">
+          {MODE_OPTIONS.map(({ mode: m, label, icon: Icon }) => (
+            <button
+              key={m}
+              type="button"
+              onClick={() => setMode(m)}
+              aria-pressed={mode === m}
+              aria-label={label}
+              title={label}
+              className={mode === m ? "is-active" : ""}
+            >
+              <Icon size={15} />
+            </button>
+          ))}
+
+          <button
+            type="button"
+            onClick={() => setOpen(false)}
+            aria-label="Close assistant"
+            title="Close"
+          >
+            <X size={15} />
+          </button>
+        </div>
+      </div>
+
+      <div className="assistant-widget-body">
+        <AssistantChatUI variant="widget" />
+      </div>
+    </div>
+  );
+}
