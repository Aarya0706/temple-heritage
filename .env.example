# Groq API key — required for the Planner and Assistant AI backends.
# Free, no credit card required: https://console.groq.com/keys
GROQ_API_KEY=

# Supabase project credentials — required for auth, Saved Temples, and My Yatras.
# Find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — your deployed domain (e.g. https://temple-heritage.vercel.app).
# Used to build correct absolute URLs for shared OG image tags. Falls back
# to Vercel's auto-injected URL on Vercel, or localhost in dev, so this is
# only needed once you're on a custom domain.
NEXT_PUBLIC_SITE_URL=
