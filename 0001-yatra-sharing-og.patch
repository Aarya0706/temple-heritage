diff --git a/app/api/yatra-plans/route.ts b/app/api/yatra-plans/route.ts
index 8953f61..c75554b 100644
--- a/app/api/yatra-plans/route.ts
+++ b/app/api/yatra-plans/route.ts
@@ -17,6 +17,31 @@ export async function POST(request: Request) {
   return NextResponse.json({ success: true })
 }
 
+export async function PATCH(request: Request) {
+  const supabase = await createClient()
+  const { data: { user } } = await supabase.auth.getUser()
+  if (!user) return NextResponse.json({ error: 'Not authenticated' }, { status: 401 })
+
+  const { id, isPublic } = await request.json()
+  if (!id || typeof isPublic !== 'boolean') {
+    return NextResponse.json({ error: 'Missing fields' }, { status: 400 })
+  }
+
+  // Scoped to this user's own row (also enforced by the
+  // yatra_plans_update_own RLS policy) — id alone can't flip someone
+  // else's plan public.
+  const { data, error } = await supabase
+    .from('yatra_plans')
+    .update({ is_public: isPublic })
+    .eq('id', id)
+    .eq('user_id', user.id)
+    .select('id, is_public')
+    .single()
+
+  if (error) return NextResponse.json({ error: error.message }, { status: 500 })
+  return NextResponse.json({ success: true, isPublic: data.is_public })
+}
